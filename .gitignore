# ---- Secrets (never commit) ----
# Real credentials live only in .env; .env.example (no real values) IS committed.
.env
.env.*
!.env.example

# ---- OS / editors ----
.DS_Store
.idea/
*.swp

# ---- Python (pipelines, Spark, ML, LLM, FastAPI) ----
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# ---- Java / Spring Boot (Maven build output) ----
target/
*.class

# ---- Node / Next.js ----
node_modules/
.next/
out/

# ---- dbt (generated files, rebuilt on every run) ----
dbt/target/
dbt/logs/
dbt/dbt_packages/

# ---- Airflow / MLflow local run output ----
logs/
mlruns/
mlartifacts/

# ---- Data and model weights ----
# Real data lives in RustFS, never in git. Small test fixtures go under */tests/fixtures/.
data/
*.parquet
*.onnx
*.safetensors
!**/tests/fixtures/**

# Phase 8: the ONNX export is rebuilt from the MLflow registry, never committed.
ml-serving/artifacts/*

# Phase 12 (ADR 0017's amendment): Render builds infra/ml-serving/Dockerfile.space from a plain
# `git clone` of this repo, with no MLflow to fetch the model from - unlike the ONNX export above,
# there is nowhere else for this one to come from, so the ~165 KB bundle export_model_bundle.py
# writes IS committed, on purpose. Re-run that script and commit again whenever `publish`
# registers a new `production` alias - the same deliberate, manual step ADR 0017 already asks for.
!ml-serving/artifacts/model-bundle/
!ml-serving/artifacts/model-bundle/**

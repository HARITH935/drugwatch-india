# DrugWatch India: environment variables (TEMPLATE, safe to commit)
#
#   1. Copy it:        cp .env.example .env
#   2. Fill in every blank value in .env. Generate strong values with:  openssl rand -hex 16
#   3. Never commit .env (it's in .gitignore). Never put real values in THIS file.
#
# docker-compose.yml refuses to start while any required value below is blank.

# ---- PostgreSQL (compose service: postgres; from your Mac: localhost:5433) ----
POSTGRES_USER=drugwatch
POSTGRES_DB=drugwatch
# Required. Set it BEFORE the first `docker compose up`: Postgres only reads it when it creates its
# data, so changing it later needs `docker compose down -v` (which deletes local data).
POSTGRES_PASSWORD=
# Not secrets, and both optional: Python running on your Mac uses these defaults if unset.
# Code running INSIDE Docker (e.g. Airflow, Phase 5) must use POSTGRES_HOST=postgres and
# POSTGRES_PORT=5432 instead - 5433 is only how the port is published to the Mac.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# ---- RustFS: S3-compatible storage (compose service: rustfs; S3 API: localhost:9000) ----
# Required. Access key = S3 "username", secret key = S3 "password". These are also your login for the
# web console (http://localhost:9001/rustfs/console/). RustFS enforces no minimum length, so use long
# random values, and never the public default "rustfsadmin".
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
# Not a secret. S3 API address for Python running on your Mac (the downloader; this is also the default
# if unset). Code running INSIDE Docker (e.g. Airflow, Phase 5) must use http://rustfs:9000 instead.
RUSTFS_ENDPOINT=http://localhost:9000

# ---- Superset dashboards (Phase 6; compose service: superset; UI: http://localhost:8088) ----
# Required. Signs session cookies and encrypts the database passwords Superset stores, so it must
# not be the well-known default. Generate one:  openssl rand -base64 42
SUPERSET_SECRET_KEY=
# Required. The Superset admin login created by `docker compose run --rm superset-init`.
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=
# Required. Signs Superset's guest tokens for embedding (Phase 9 step 7). Its own secret, not
# reused from SUPERSET_SECRET_KEY: one leaked value must not forge both session cookies and guest
# tokens. Generate one:  openssl rand -hex 32
SUPERSET_GUEST_TOKEN_SECRET=
# Required. The Superset service account the API logs in as to mint guest tokens. It holds one
# permission (can_grant_guest_token) and nothing else - see infra/superset/configure_embedding.py.
SUPERSET_EMBED_USERNAME=embed_service
SUPERSET_EMBED_PASSWORD=

# Not secrets. Superset's embedded-dashboard UUIDs, printed by
# infra/superset/configure_embedding.py. A dashboard with no UUID here cannot be embedded, which
# is the allowlist: one added later stays private until somebody lists it.
SUPERSET_URL=http://localhost:8088
SUPERSET_DASHBOARD_MANUFACTURER=
SUPERSET_DASHBOARD_STATES=
SUPERSET_DASHBOARD_DRUG_CLASSES=
SUPERSET_DASHBOARD_SPURIOUS=

# Required. Password for the `superset_reader` Postgres role, which has SELECT on the gold schema
# and nothing else (infra/postgres/superset_reader.sql). Generate one:  openssl rand -hex 16
SUPERSET_READER_PASSWORD=

# ---- Backend API (Phase 9; compose service: backend; http://localhost:8080) ----
# Required. Password for the `drugwatch_api` Postgres role, which can SELECT on the gold schema
# and owns the `app` schema, and nothing else (infra/postgres/api_role.sql). Generate one:
# openssl rand -hex 24
API_DB_PASSWORD=

# Required. Signs the API's access tokens. At least 32 bytes, or the application refuses to
# start: a short or shared secret means anybody can mint a token for any account.
# Generate one:  openssl rand -hex 32
JWT_SECRET=
# Not a secret. Where links in emails point (the Next.js site in Phase 11).
SITE_URL=http://localhost:3100
# Not a secret. The Phase 8 risk service. Use 127.0.0.1 rather than localhost: Java's HTTP client
# prefers IPv6 for "localhost", and the published Docker port is IPv4-only.
RISK_API_URL=http://127.0.0.1:8000
# Not a secret. Requests per minute per caller on the public lookups (step 6). Generous for a
# person, cheap to exceed for a script.
RATE_LIMIT_PER_MINUTE=60

# ---- MLflow: experiment tracking + model registry (Phase 7; compose service: mlflow) ----
# Not a secret. Where the training code and Phase 8's serving container find the tracking server.
# Host 5050 because macOS AirPlay Receiver listens on 5000. Code running INSIDE Docker must use
# http://mlflow:5000 instead. MLflow has no credentials of its own: it reuses the Postgres and
# RustFS ones above, and because the server proxies artifacts (--serve-artifacts) the training
# code holds no S3 keys at all.
MLFLOW_TRACKING_URI=http://localhost:5050

# ---- SMTP email: shared by Airflow failure alerts (Phase 5) and Spring Boot watchlist emails (Phase 9) ----
# Local dev = Mailpit: accepts any username/password, nothing leaves your Mac. Inbox: http://localhost:8025
# Code running INSIDE Docker (e.g. Airflow) must use SMTP_HOST=mailpit instead of localhost.
# Production (Phase 12) = Brevo: smtp-relay.brevo.com, port 587, SMTP_STARTTLS=true, credentials from your
# Brevo account. Those real values go in the server's environment, never in this file.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=drugwatch
SMTP_PASSWORD=any-value-works-with-mailpit
SMTP_STARTTLS=false
SMTP_FROM=alerts@drugwatch.local
# Where Airflow sends pipeline failure alerts (Phase 5 step 4). Optional: defaults to the address
# above. Locally Mailpit catches everything whatever you put here (inbox: http://localhost:8025);
# in production this is a real inbox.
ALERT_EMAIL_TO=alerts@drugwatch.local

# --- Frontend (Phase 11) ---
# Not a secret. Where the Next.js server reaches the Spring API. Read by frontend/next.config.ts,
# which takes ONLY the keys it needs from this file - not the database or JWT secrets above.
# Defaults to http://localhost:8080 when unset. The site itself runs on :3100 (SITE_URL above).
BACKEND_URL=http://localhost:8080
# Not a secret either, but deliberately public (NEXT_PUBLIC_ prefix): step 6's embedded dashboards
# are an iframe the BROWSER loads directly, not an API call Next.js proxies, so this is the one
# frontend value that has to reach client JavaScript (ADR 0020's amendment). Same value as
# SUPERSET_URL above on this Mac; in production they can differ (SUPERSET_URL can stay internal
# to the Docker network, this one has to be the public address).
NEXT_PUBLIC_SUPERSET_URL=http://localhost:8088

# --- Phase 12: production platforms (ADR 0021). Unset locally - only needed by scripts that
# talk to the production services directly, such as infra/postgres/publish_gold.sh. ---
# Neon's own connection string (its dashboard shows it after you create a project), e.g.
#   postgresql://<user>:<password>@<host>/<db>?sslmode=require&channel_binding=require
# Quote it in your real .env: unescaped & and ? would otherwise break `. ./.env`.
NEON_DATABASE_URL=
# The same connection string with "-pooler" removed from the hostname. Neon's pooled connection
# runs PgBouncer in transaction mode, which can break the multi-statement sessions pg_dump,
# pg_restore and role-creation DDL need - so the admin scripts use this one instead.
NEON_DATABASE_URL_DIRECT=
# Fresh passwords for the two Neon roles (infra/postgres/neon_api_role.sql,
# neon_superset_reader.sql) - deliberately NOT the same values as the local API_DB_PASSWORD /
# SUPERSET_READER_PASSWORD above, so a leaked local .env can't also reach production.
NEON_API_DB_PASSWORD=
NEON_SUPERSET_READER_PASSWORD=
# Upstash's own connection string, e.g. rediss://default:<password>@<host>:<port>
UPSTASH_REDIS_URL=

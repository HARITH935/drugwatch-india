# DrugWatch India: environment variables (TEMPLATE, safe to commit)
#
#   1. Copy it:        cp .env.example .env
#   2. Fill in every blank value in .env. Generate strong values with:  openssl rand -hex 16
#   3. Never commit .env (it's in .gitignore). Never put real values in THIS file.
#
# docker-compose.yml refuses to start while any required value below is blank.

# ---- PostgreSQL (compose service: postgres; from your Mac: localhost:5433) ----
POSTGRES_USER=drugwatch
POSTGRES_DB=drugwatch
# Required. Set it BEFORE the first `docker compose up`: Postgres only reads it when it creates its
# data, so changing it later needs `docker compose down -v` (which deletes local data).
POSTGRES_PASSWORD=

# ---- RustFS: S3-compatible storage (compose service: rustfs; S3 API: localhost:9000) ----
# Required. Access key = S3 "username", secret key = S3 "password". These are also your login for the
# web console (http://localhost:9001/rustfs/console/). RustFS enforces no minimum length, so use long
# random values, and never the public default "rustfsadmin".
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=

# ---- SMTP email: shared by Airflow failure alerts (Phase 5) and Spring Boot watchlist emails (Phase 9) ----
# Local dev = Mailpit: accepts any username/password, nothing leaves your Mac. Inbox: http://localhost:8025
# Code running INSIDE Docker (e.g. Airflow) must use SMTP_HOST=mailpit instead of localhost.
# Production (Phase 12) = Brevo: smtp-relay.brevo.com, port 587, SMTP_STARTTLS=true, credentials from your
# Brevo account. Those real values go in the server's environment, never in this file.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=drugwatch
SMTP_PASSWORD=any-value-works-with-mailpit
SMTP_STARTTLS=false
SMTP_FROM=alerts@drugwatch.local
